%maxcore 1125
%pal
    nprocs 16
end

%Compound

  # ------------------------------------
  # First job (Step 1)
  # Optimize geometry
  # ------------------------------------

  NewStep
  %base "optimization"

    !B3LYP D4 def2-svp Opt Freq TightSCF

    %basis
      NewGTO Ni "def2-TZVP" end
    end

    %scf
        maxiter 300
    end

    %geom
        Constraints
        # (none by default; add constraints here if needed)
        end
    end

    *xyzfile 0 1 init.xyz

  StepEnd

  # ------------------------------------
  # Second job (Step 2) with geometry (Step 1)
  # but different functional
  # ------------------------------------

  ReadGeom(1);
  NewStep
  %base "singepoint"
    !M06 D4 def2-TZVP TightSCF FMOPop
    %scf guess MORead end
    %output
      jsonpropfile true
      jsongbwfile true
    end
  StepEnd

  # ------------------------------------
  # Third job (Step 3) with geometry (Step 1)
  # adding NBO calculation, NBOEXE path must be set
  # in slurm script (for Resnik)
  # export NBOEXE=/resnick/groups/ReismanLab/nbo7/bin/nbo7.i8.exe
  # export GENEXE=/resnick/groups/ReismanLab/nbo7/bin/gennbo.i8.exe
  # ------------------------------------

  ReadGeom(1);
  ReadMOs(2);

  NewStep
  %base "nborun"

  !M06 D4 def2-TZVP TightSCF NBO NPA
  %scf guess MORead end
  %output
    jsonpropfile true
    jsongbwfile true
  end
  StepEnd

  # ------------------------------------
  # Forth job (Step 4) with geometry (Step 1)
  # adding NMR calculation, uses GIAO by default
  # ------------------------------------

  ReadGeom(1);
  ReadMOs(2);

  NewStep
  %base "nmr"

  !M06 D4 def2-TZVP TightSCF NMR
  %scf guess MORead end
  %output
    jsonpropfile true
    jsongbwfile true
  end
  StepEnd
EndRun
