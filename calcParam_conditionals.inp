%maxcore 1125
%pal
    nprocs 16
end

%Compound

# ------Settings -------
Variable conf_search = true;
Variable opt_geom = true;
Variable freq_calc = true;
Variable nmr_calc = true;
Variable vertical_redox = true;

# ------ General Variables ------
Variable input_xyz = "inp.xyz";
Variable multiplicity = 1;
Variable charge = 0;

# ------ GOAT optimization ------
Variable goat_method = "XTB";
Variable var_goat = "GOAT";
Variable goat_solvent = "";

# ------ DFT Optimization + Freq of Lowest En ------
Variable opt_method = "wb97m-d4 def2-tzvp(-f)";
Variable Ni_extra_basis = "def2-tzvp";
Variable opt_solvent = "";
Variable geom_constraints = "";

# -- Single Point variables -- 
Variable svp_method = "wb97m-d4 def2-tzvp(-f)";
Variable property_solvent = "";
Variable nmr_method = "wb97m-d4 def2-tzvp(-f)";

Variable nbo_run = "NBO NPA"; # NBOEXE and GENEXE must be set (external to Orca)

# -------- vertical oxidation/reduction multiplicity and charges ------
Variable ox_chrg = charge + 1;
Variable ox_mult = multiplicity + 1;
Variable red_chrg = charge - 1;
Variable red_mult = multiplicity + 1;

Variable opt_geom;

if (conf_search) then
    # ------------------------------------
    # GOAT optimization
    # ------------------------------------

    NewStep
    %base "conf_search"
    ! &{var_goat} &{goat_method} &{goat_solvent} 
    * xyzfile &{charge} &{multiplicity} &{input_xyz}
    Step_end

    input_xyz = "conf_search.globalminimum.xyz";
EndIf

if (opt_geom) then
    # ------------------------------------
    # Optimize geometry
    # ------------------------------------

    NewStep
    %base "optimization"

    ! &{opt_method} &{opt_solvent} Opt TightSCF PModel

    %basis
        NewGTO Ni "&{Ni_extra_basis}" end
    end

    %scf
        maxiter 300
    end

    %geom
        Constraints
        &{geom_constraints}
        end
    end

    *xyzfile &{charge} &{multiplicity} &{input_xyz}

    StepEnd

    opt_geom = "optimization.xyz"

else
    opt_geom = input_xyz;

EndIf

Variable scf_guess = "PModel";

if (freq_calc) then
    # ------------------------------------
    # Frequency calculation
    # ------------------------------------

    if (opt_geom) then
        scf_guess = "MORead";
    EndIf

    NewStep
    %base "frequency"

    ! &{opt_method} &{opt_solvent} Freq TightSCF

    %basis
        NewGTO Ni "&{Ni_extra_basis}" end
    end
    %scf
        guess &{scf_guess}
        maxiter 300
    end

    %output
        jsonpropfile true
        jsongbwfile true
    end

    StepEnd
endif

# ------------------------------------
# but different functional
# ------------------------------------

NewStep
%base "singlepoint"

! &{svp_method} &{property_solvent} TightSCF &{nbo_run} FMOPop HIRSHFELD CHELPG ADLD

%scf
    maxiter 300
end

%output
    jsonpropfile true
    jsongbwfile true
end

%elprop
    Polar true
    PolarAtom true
    Dipole true
    DipoleAtom true
    Quadrupole true
    QuadrupoleAtom true
end

StepEnd

if (nmr_calc) then

    # ------------------------------------
    # NMR calculation, uses GIAO by default
    # ------------------------------------

    NewStep

    %base "nmr"

    ! &{nmr_method} &{property_solvent} TightSCF NMR

    %scf guess MORead end

    %output
    jsonpropfile true
    jsongbwfile true
    end

    StepEnd
endif

if (vertical_redox) then
    # ------------------------------------------------------------------------
    # Vertical (no optimization) oxidation
    # ------------------------------------------------------------------------

    NewStep

    %base "oxidation"

    ! &{svp_method} &{property_solvent} TightSCF &{nbo_run} HIRSHFELD CHELPG

    %output
    jsonpropfile true
    jsongbwfile true
    end

    *xyzfile &{ox_chrg} &{ox_mult} optimization.xyz

    StepEnd


    # ------------------------------------------------------------------------
    # Vertical (no optimization) reduction
    # ------------------------------------------------------------------------

    NewStep

    %base "reduction"

    ! &{svp_method} &{property_solvent} TightSCF &{nbo_run} HIRSHFELD CHELPG

    %output
    jsonpropfile true
    jsongbwfile true
    end

    *xyzfile &{red_chrg} &{red_mult} optimization.xyz

    StepEnd
EndIf

EndRun
